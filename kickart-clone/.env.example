# Kickart Clone 环境变量配置示例
# 复制为 .env 并修改

# ============ 应用配置 ============
KICKART_APP_NAME=kickart-clone
KICKART_APP_VERSION=1.0.0
KICKART_DEBUG=false
KICKART_ENVIRONMENT=production

# ============ API 服务 ============
KICKART_API_HOST=0.0.0.0
KICKART_API_PORT=8765
KICKART_API_WORKERS=4
KICKART_API_TIMEOUT=300

# ============ 日志 ============
KICKART_LOG_LEVEL=INFO
KICKART_LOG_FORMAT=json
KICKART_LOG_FILE=/data/logs/app.log

# ============ Stable Diffusion ============
KICKART_SD_WEBUI_URL=http://localhost:7860
KICKART_SD_TIMEOUT=120
KICKART_SD_MAX_CONCURRENT=2

# ============ Lead Agent ============
KICKART_LEAD_AGENT_OUTPUT_DIR=/data/runs
KICKART_LEAD_AGENT_MAX_RETRIES=3
KICKART_LEAD_AGENT_TASK_TIMEOUT=120

# ============ 视频 ============
KICKART_VIDEO_OUTPUT_DIR=/data/videos
KICKART_VIDEO_DEFAULT_FPS=25
KICKART_VIDEO_DEFAULT_RESOLUTION=1080x1920

# ============ TTS ============
KICKART_TTS_OUTPUT_DIR=/data/audio
KICKART_TTS_DEFAULT_VOICE=xiaoxiao

# ============ 平台 ============
KICKART_JNPF_OUTPUT_DIR=/data/jnpf
KICKART_COMPOUND_REGISTRY_DIR=/data/compound_registry
KICKART_TENANT_STORAGE_DIR=/data/tenants
KICKART_MONITORING_STORAGE_DIR=/data/monitoring

# ============ 安全 ============
KICKART_API_KEY_ENABLED=false
KICKART_RATE_LIMIT_ENABLED=true
KICKART_RATE_LIMIT_REQUESTS=60
KICKART_RATE_LIMIT_BURST=10

# ============ 性能 ============
KICKART_MAX_CONCURRENT_WORKFLOWS=5
KICKART_TASK_QUEUE_SIZE=100
KICKART_ENABLE_SSE=true

# ============ 监控 ============
KICKART_METRICS_ENABLED=true
KICKART_METRICS_PATH=/metrics

# ============ LLM 多提供商配置 ============
# 路由策略：failover(故障转移) / round_robin(轮询) / least_used(最少使用) / random(随机)
KICKART_LLM_STRATEGY=failover
# 默认用途：jnpf_team / cross_border_ecommerce / aigc_marketing / image_generation / default
KICKART_LLM_DEFAULT_PURPOSE=aigc_marketing
# 是否启用熔断器
KICKART_LLM_BREAKER_ENABLED=true
# 熔断阈值（连续失败次数）
KICKART_LLM_BREAKER_THRESHOLD=3
# 熔断冷却时间（秒）
KICKART_LLM_BREAKER_COOLDOWN=60

# ============ DeepSeek API Keys（3 个） ============
# #1 JNPF团队用途
DEEPSEEK_KEY_JNPF=sk-1bb...5947
# #2 跨境电商+Paperclip CN 用途
DEEPSEEK_KEY_ECOMMERCE=sk-a2a...444e
# #3 AIGC数字营销中台用途
DEEPSEEK_KEY_AIGC=sk-9fc...4a72

# ============ 智谱 GLM API Key ============
# 跨境电商AI智能体用途
GLM_KEY_ECOMMERCE=a231...3ebG

# ============ 火山引擎 Ark API Keys（2 个） ============
# #1 AIGC中台默认（豆包）
ARK_KEY_DEFAULT=ark-556...9e66a
# #2 AIGC中台备用
ARK_KEY_BACKUP=ark-915...e8fc3

# ============ Stability AI API Key ============
# 图片生成用途
STABILITY_KEY=sk-2Aj...iedJ
